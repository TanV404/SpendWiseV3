# Database Configuration (PostgreSQL in Docker / Production, sqlite:///./dev.db for local dev)
DATABASE_URL=postgresql://spendwise:spendwise_password@localhost:5432/spendwise

# JWT Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Alerts & Notification Dispatcher (Resend API)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:8000
